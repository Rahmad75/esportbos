{
  "firestore": {
    "database": "ai-studio-esportbos-a5699ac0-157f-46a0-981e-0d420edc4ad0",
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "data/**",
      "server.js",
      "economy-server.js",
      "package.json",
      "package-lock.json",
      "bun.lock",
      "eslint.config.mjs",
      "firebase-blueprint.json",
      "security_spec.md",
      "CNAME"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "asia-southeast1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
