{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{economy.config.json,firebase-applet-config.json,src/**,*.html,*.js,*.css,*.png,*.jpeg,*.ico,site.webmanifest}"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "has": [
        { "type": "header", "key": "origin", "value": "https://esportbos.com" }
      ],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://esportbos.com" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Device-Id, X-Requested-With, X-Server-Sync-Ms" },
        { "key": "Vary", "value": "Origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "has": [
        { "type": "header", "key": "origin", "value": "https://www.esportbos.com" }
      ],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.esportbos.com" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Device-Id, X-Requested-With, X-Server-Sync-Ms" },
        { "key": "Vary", "value": "Origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "has": [
        { "type": "header", "key": "origin", "value": "https://esportbos-i2du.vercel.app" }
      ],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://esportbos-i2du.vercel.app" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Device-Id, X-Requested-With, X-Server-Sync-Ms" },
        { "key": "Vary", "value": "Origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
